{
  "expo": {
    "name": "GestVente Phone",
    "slug": "adil-gestventephone",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "gestvente",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.adil.gestvente",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#283593",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.adil.gestvente"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "GestVente Phone",
      "shortName": "GestVente",
      "lang": "fr",
      "themeColor": "#283593",
      "backgroundColor": "#F3F4F8",
      "description": "Ventes, stock IMEI, caisse et rapports d'une boutique de téléphones, même hors ligne."
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#283593",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "La caméra sert à scanner les codes-barres et les IMEI des produits.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Les photos servent à illustrer les fiches produits.",
          "cameraPermission": "La caméra sert à photographier les produits.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "react-native-ble-plx"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
