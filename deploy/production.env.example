# Copier en .env.prod à la racine du dépôt, sur le serveur, puis remplir chaque valeur.
# Jamais dans Git. Générer chaque secret avec :
#   openssl rand -base64 48

# Nom de domaine pointant vers le serveur (enregistrement A) et adresse pour Let's Encrypt.
DOMAINE=gestvente.exemple.com
ACME_EMAIL=contact@exemple.com

# Base de données (le port n'est pas ouvert à l'extérieur).
POSTGRES_USER=gestvente
POSTGRES_PASSWORD=a-generer
POSTGRES_DB=gestvente

# Signature des sessions (48 caractères aléatoires au moins).
JWT_SECRET=a-generer

# Clé de chiffrement des sauvegardes : à garder AUSSI hors du serveur (sans elle,
# les sauvegardes sont illisibles).
SAUVEGARDE_CLE=a-generer
# Conservation (jours) et heure UTC de la sauvegarde quotidienne.
SAUVEGARDE_JOURS=14
SAUVEGARDE_HEURE=02
