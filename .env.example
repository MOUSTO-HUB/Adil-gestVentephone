# Copier ce fichier en .env puis adapter les valeurs.

# --- Base de données (docker-compose) ---
# Ports 5434 et 6380 : pas de conflit avec d’autres projets (5432, 5433, 6379).
POSTGRES_USER=gestvente
POSTGRES_PASSWORD=gestvente_dev
POSTGRES_DB=gestvente
POSTGRES_PORT=5434
DATABASE_URL=postgresql://gestvente:gestvente_dev@localhost:5434/gestvente?schema=public

# --- Redis (files d'envoi : SMS, WhatsApp, rappels) ---
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# --- API ---
API_PORT=3200
# Origines autorisées (version web de l'application), séparées par des virgules.
APP_ORIGIN=http://localhost:8081

# --- Application (Expo) ---
# Sur un téléphone physique, remplacer localhost par l'adresse IP du PC.
EXPO_PUBLIC_API_URL=http://localhost:3200/api

# --- Données de démonstration (pnpm db:seed) ---
# Mot de passe des comptes créés par le seed (développement uniquement).
SEED_MOT_DE_PASSE=GestVente-Dev-2026

# --- Authentification ---
# Au moins 32 caractères aléatoires. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=a-remplacer-par-une-valeur-aleatoire-de-48-caracteres
