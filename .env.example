# Copier ce fichier en .env puis adapter les valeurs.

# --- Base de données (docker-compose) ---
# Ports 5433 et 6380 : pas de conflit avec un autre projet qui utilise 5432 et 6379.
POSTGRES_USER=gestvente
POSTGRES_PASSWORD=gestvente_dev
POSTGRES_DB=gestvente
POSTGRES_PORT=5433
DATABASE_URL=postgresql://gestvente:gestvente_dev@localhost:5433/gestvente?schema=public

# --- Redis (files d'envoi : SMS, WhatsApp, rappels) ---
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# --- API ---
API_PORT=3200
# Origines autorisées (version web de l'application), séparées par des virgules.
APP_ORIGIN=http://localhost:8081

# --- Application (Expo) ---
# Sur un téléphone physique, remplacer localhost par l'adresse IP du PC.
EXPO_PUBLIC_API_URL=http://localhost:3200/api
